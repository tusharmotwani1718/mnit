# Copy to .env.local (never put real values in this file).

# Agent core (core/ → npm start). Server-side only.
CORE_URL=
# Same value as CORE_API_KEY in core/.env (leave empty if core has none)
CORE_API_KEY=
# Same value as LIVE_VIEW_TOKEN in core/.env
LIVE_VIEW_TOKEN=

# LiveKit Cloud project, for "Call from browser". Server-side only.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Must match AGENT_NAME in voice/.env
AGENT_NAME=yojana_darshak

# Shown on the site as "Call our agent" (public: it is printed on the page), e.g. +1 555 010 0000
NEXT_PUBLIC_CALL_NUMBER=
