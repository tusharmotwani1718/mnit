{
  "name": "yojana-darshak-core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "chat": "node --env-file-if-exists=.env --import tsx src/cli/chat.ts",
    "start": "node --env-file-if-exists=.env --import tsx src/main.ts",
    "dev": "node --env-file-if-exists=.env --watch --import tsx src/main.ts",
    "rag:ingest": "node --env-file-if-exists=.env --import tsx src/cli/ragIngest.ts",
    "rag:eval": "node --env-file-if-exists=.env --import tsx src/cli/ragEval.ts"
  },
  "dependencies": {
    "express": "^5.3.0",
    "openai": "^7.45.1",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
