OPENAI_API_KEY=
OPENAI_MODEL=
PORT=8080
# Shared secret the voice worker sends as "Authorization: Bearer <key>". Leave empty only for local testing.
CORE_API_KEY=
# Origin allowed to call the API from a browser (e.g. http://localhost:3000). Empty = no CORS.
CORS_ORIGIN=
# Token the live panel sends as ?token= to read /live (call transcripts). Leave empty only for local testing.
LIVE_VIEW_TOKEN=
# Checklist SMS: android (SMS Gateway for Android app) | twilio | log (dry run, default)
SMS_PROVIDER=android
SMS_GATEWAY_URL=https://api.sms-gate.app/3rdparty/v1
SMS_GATEWAY_USER=
SMS_GATEWAY_PASSWORD=
# RAG (Supabase pgvector): Supabase → Connect → "Session pooler" connection string (IPv4)
DATABASE_URL=
# Optional: Supabase CA certificate (PEM text) to verify TLS; without it TLS is encrypted but unverified
DATABASE_CA_CERT=
RAG_EMBED_MODEL=text-embedding-3-small
