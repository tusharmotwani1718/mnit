# LiveKit Cloud project (Settings → Keys)
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

GNANI_API_KEY=

# Agent core (core/ → npm start)
CORE_URL=http://localhost:8080
# Same value as CORE_API_KEY in core/.env
CORE_API_KEY=

# Optional
DEFAULT_LANG=hi
GNANI_VOICE_HI=Nalini
GNANI_VOICE_MR=Zahira
GNANI_VOICE_EN=Kaveri
FILLER_AFTER_SECONDS=1.5
# Set when using explicit dispatch (e.g. SIP dispatch rules); empty = join every new room
AGENT_NAME=yojana_darshak
# Background-noise tolerance (raise if the agent stops for noise, lower if it misses real speech)
VAD_ACTIVATION_THRESHOLD=0.65
VAD_MIN_SPEECH_SECONDS=0.2
MIN_INTERRUPTION_SECONDS=0.8
# LiveKit Cloud noise cancellation on caller audio: on | off
NOISE_CANCELLATION=on
